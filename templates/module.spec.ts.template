import { test,expect } from './fixture';
test('contributor local module appears without extension edits and cleans on Reset/Close',async({page,activate})=>{
 await page.goto('http://127.0.0.1:4173/');await activate(page);await page.getByRole('tab',{name:'Inspect',exact:true}).click();await page.getByRole('button',{name:'Enable Heading outlines',exact:true}).click();await expect(page.getByRole('status')).toContainText('3 heading outlines active');await expect(page.locator('[data-accesslab-overlay] .outline')).toHaveCount(3);await page.screenshot({path:'artifacts/tutorial-module.png',caret:'initial'});await page.getByRole('button',{name:'Reset',exact:true}).click();await expect(page.locator('[data-accesslab-overlay] .outline')).toHaveCount(0);await page.getByRole('button',{name:'Enable Heading outlines',exact:true}).click();await page.getByRole('button',{name:'Close AccessLab'}).click();await expect(page.locator('[data-accesslab-root],[data-accesslab-overlay]')).toHaveCount(0);
});
